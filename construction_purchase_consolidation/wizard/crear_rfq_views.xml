<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crear_rfq_consolidada_wizard_form" model="ir.ui.view">
        <field name="name">crear.rfq.consolidada.wizard.form</field>
        <field name="model">crear.rfq.consolidada.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Solicitud de Cotización (RFQ)">
                <group>
                    <field name="proveedor_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <field name="resumen" readonly="1"/>
                <field name="linea_ids" invisible="1"/>
                <footer>
                    <button name="action_generar" type="object" string="Crear Solicitud de Cotización (RFQ)" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
