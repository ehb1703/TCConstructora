<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_product_budget_item" model="ir.actions.act_window">
        <field name="name">Partida Presupuestal</field>
        <field name="res_model">product.budget.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_product_budget_item_list" model="ir.ui.view">
        <field name="name">view.product.budget.item.list</field>
        <field name="model">product.budget.item</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list string="Partida Presupuestal">
                <field name="parent_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
            </list>
        </field>
    </record>

    <record id="view_product_budget_item_from" model="ir.ui.view">
        <field name="name">view.product.budget.item.from</field>
        <field name="model">product.budget.item</field>
        <field name="arch" type="xml">
            <form string="Partida Presupuestal" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="level"/>
                        <field name="parent_id" required="level != 1"/>
                        <field name="code"/>
                        <!--field name="name"/-->
                    </group>
                    <field name="line_ids" widget="one2many_list">
                        <list string="Detalles" delete="0" create="0" edit="0" context="{'default_line_id': id}">
                            <field name="company_id" options="{'no_open': 1,'no_create':1,'no_create_edit':1}"/>
                            <field name="lead_id" options="{'no_open': 1,'no_create':1,'no_create_edit':1}"/>
                            <field name="name"/>
                        </list>
                        <form><p>Información no disponible a través de esta vista</p></form>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Familias Insumos -->
    <record id="action_familia_insumo" model="ir.actions.act_window">
        <field name="name">Familias Insumos</field>
        <field name="res_model">product.familia.insumo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_familia_insumo_tree" model="ir.ui.view">
        <field name="name">product.familia.insumo.list</field>
        <field name="model">product.familia.insumo</field>
        <field name="arch" type="xml">
            <list string="Familias Insumos">
                <field name="codigo"/>
                <field name="name"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>

    <record id="view_familia_insumo_form" model="ir.ui.view">
        <field name="name">product.familia.insumo.form</field>
        <field name="model">product.familia.insumo</field>
        <field name="arch" type="xml">
            <form string="Familia de Insumos">
                <sheet>
                    <group>
                        <group>
                            <field name="codigo"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Categorías Insumos -->
    <record id="action_categoria_insumo" model="ir.actions.act_window">
        <field name="name">Categorías Insumos</field>
        <field name="res_model">product.categoria.insumo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_categoria_insumo_tree" model="ir.ui.view">
        <field name="name">product.categoria.insumo.list</field>
        <field name="model">product.categoria.insumo</field>
        <field name="arch" type="xml">
            <list string="Categorías Insumos">
                <field name="codigo"/>
                <field name="name"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>

    <record id="view_categoria_insumo_form" model="ir.ui.view">
        <field name="name">product.categoria.insumo.form</field>
        <field name="model">product.categoria.insumo</field>
        <field name="arch" type="xml">
            <form string="Categoría de Insumos">
                <sheet>
                    <group>
                        <group>
                            <field name="codigo"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="descripcion"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <menuitem id="menu_product_budget_main" name="Partida Presupuestal" action="action_product_budget_item" parent="sale.product_menu_catalog" groups="sales_team.group_sale_salesman" sequence="40"/>
    
    <menuitem id="menu_familia_insumo_compras" name="Familias Insumos" parent="purchase.menu_purchase_products" action="action_familia_insumo" sequence="2" groups="purchase.group_purchase_user,purchase.group_purchase_manager"/>
    <menuitem id="menu_categoria_insumo_compras" name="Categorías Insumos" parent="purchase.menu_purchase_products" action="action_categoria_insumo" sequence="3" groups="purchase.group_purchase_user,purchase.group_purchase_manager"/>

</odoo>
