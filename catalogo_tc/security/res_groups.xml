<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_admin_catalogo" model="res.groups">
        <field name="name">Administrador del Catálogo de Insumos</field>
        <field name="category_id" ref="base.module_category_inventory_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Da de alta insumos, los clasifica, autoriza combinaciones categoría-familia y resuelve conflictos de códigos.</field>
    </record>
</odoo>
