<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalogo_alta_wizard_form" model="ir.ui.view">
        <field name="name">catalogo.alta.wizard.form</field>
        <field name="model">catalogo.alta.wizard</field>
        <field name="arch" type="xml">
            <form string="Alta de insumo">
                <group invisible="not linea_id">
                    <field name="linea_id" invisible="1"/>
                    <field name="codigo_externo"/>
                    <field name="descripcion_externa"/>
                </group>
                <group>
                    <field name="accion" widget="radio"/>
                    <field name="existente_id" invisible="accion != 'existente'" required="accion == 'existente'" options="{'no_create': True}"/>
                    <field name="sin_clave_id" invisible="accion != 'clasificar'" required="accion == 'clasificar'" options="{'no_create': True}"/>
                </group>
                <group invisible="accion not in ('nuevo', 'clasificar')">
                    <group invisible="accion != 'nuevo'">
                        <field name="nombre"/>
                        <field name="uom_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="clave_proxima"/>
                        <field name="tipo_id" options="{'no_create': True}"/>
                        <field name="categoria_id" options="{'no_create': True}"/>
                        <field name="familia_id" options="{'no_create': True}" required="accion == 'clasificar'"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not duplicado_ids or accion != 'nuevo'">
                    Posibles duplicados: revise si alguno de estos insumos ya es el mismo antes de dar de alta uno nuevo.
                </div>
                <field name="duplicado_ids" invisible="not duplicado_ids or accion != 'nuevo'" readonly="1">
                    <list>
                        <field name="clave_insumo_tc"/>
                        <field name="name"/>
                        <field name="uom_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_aplicar" string="Aplicar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
