<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalogo_unificar_wizard_form" model="ir.ui.view">
        <field name="name">catalogo.unificar.wizard.form</field>
        <field name="model">catalogo.unificar.wizard</field>
        <field name="arch" type="xml">
            <form string="Unificar insumos duplicados">
                <div class="alert alert-info" role="alert">
                    Se conserva un insumo; los demás quedan archivados y su referencia y equivalencias apuntan al que se conserva
                    (buscar la referencia anterior sigue encontrando el insumo). No se borra nada: lo ya comprado o presupuestado conserva su historia.
                </div>
                <group>
                    <field name="producto_ids" widget="many2many_tags" readonly="1"/>
                    <field name="conservar_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                </group>
                <field name="resumen" nolabel="1"/>
                <footer>
                    <button name="action_unificar" type="object" string="Unificar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_catalogo_unificar_wizard" model="ir.actions.act_window">
        <field name="name">Unificar duplicados</field>
        <field name="res_model">catalogo.unificar.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('catalogo_tc.group_admin_catalogo'))]"/>
    </record>

    <!-- Insumos > Duplicados por unificar: productos de compra activos con el mismo nombre y la misma unidad -->
    <record id="action_catalogo_duplicados" model="ir.actions.server">
        <field name="name">Duplicados por unificar</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">action = model.action_duplicados_por_unificar()</field>
    </record>
    <menuitem id="menu_catalogo_duplicados" name="Duplicados por unificar" parent="menu_catalogo_tc_root" action="action_catalogo_duplicados"
              sequence="12" groups="catalogo_tc.group_admin_catalogo"/>
</odoo>
