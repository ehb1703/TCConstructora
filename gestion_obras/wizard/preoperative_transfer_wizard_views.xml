<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_presupuesto_preoperativo_transfer_wizard_form" model="ir.ui.view">
            <field name="name">presupuesto.preoperativo.transfer.wizard.form</field>
            <field name="model">presupuesto.preoperativo.transfer.wizard</field>
            <field name="arch" type="xml">
                <form string="Asistente de Traslado y Compensación">
                    <group>
                        <group>
                            <field name="target_analytic_id"/>
                        </group>
                        <group>
                            <field name="transfer_date"/>
                            <field name="user_id"/>
                            <field name="total_preoperative_incurred" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Matriz de Mapeo y Conciliación" name="mapping">
                            <field name="transfer_line_ids">
                                <list editable="bottom">
                                    <field name="preoperative_line_id" readonly="1"/>
                                    <field name="target_analytic_id"/>
                                    <field name="amount_incurred_to_deduct" sum="Total Descuento"/>
                                    <field name="reconciliation_status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones" name="notes">
                            <field name="notes" placeholder="Escriba la justificación técnica del traslado..."/>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_execute_transfer" string="Procesar Traslado y Compensación" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
