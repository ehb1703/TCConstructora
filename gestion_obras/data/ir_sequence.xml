<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_gestion_obra_contrato" model="ir.sequence">
            <field name="name">Contratos de obra</field>
            <field name="code">gestion.obra.contrato</field>
            <field name="prefix">CTR-%(year)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"></field>
        </record>

        <record id="seq_gestion_obra_modificacion" model="ir.sequence">
            <field name="name">Modificaciones presupuestales de obra</field>
            <field name="code">gestion.obra.modificacion</field>
            <field name="prefix">MOD-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"></field>
        </record>
    </data>
</odoo>
