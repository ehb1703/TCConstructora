<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_presupuesto_base" model="ir.actions.act_window">
        <field name="name">Presupuesto Base</field>
        <field name="res_model">gestion.obra.presupuesto.base</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_gestion_obra_presupuesto_base_list" model="ir.ui.view">
        <field name="name">view.gestion.obra.presupuesto.base.list</field>
        <field name="model">gestion.obra.presupuesto.base</field>
        <field name="arch" type="xml">
            <list string="Presupuesto Base">
                <field name="lead_id"/>
                <field name="name"/>
                <field name="presupuesto"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_gestion_obra_presupuesto_base_kanban" model="ir.ui.view">
        <field name="name">view.gestion.obra.presupuesto.base.kanban</field>
        <field name="model">gestion.obra.presupuesto.base</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0" group_create="0" group_delete="0" group_edit="0" quick_create="0" create="0">
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="lead_id"/>
                        <footer>
                            <field name="presupuesto" widget="monetary"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_gestion_obra_presupuesto_base_form" model="ir.ui.view">
        <field name="name">view.gestion.obra.presupuesto.base.form</field>
        <field name="model">gestion.obra.presupuesto.base</field>
        <field name="arch" type="xml">
            <form string="Presupuesto Base" create="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="lead_id" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                        <field name="presupuesto"/>
                    </group>
                    <notebook>
                        <page name="partidas" string="Partidas">
                            <group>
                                <field name="baseprep_ids" nolabel="1" widget="one2many_list">                        
                                    <list delete="0" create="0" edit="0" context="{'default_base_id': id}">
                                        <field name="budget_id"/>
                                        <field name="name_lead" string="Descripción"/>
                                        <field name="price"/>
                                    </list>
                                    <form><p>Información no disponible a través de esta vista</p></form>
                                </field>
                            </group>
                        </page>
                        <page name="presupuesto" string="Presupuesto">
                            <group>
                                <field name="line_ids" nolabel="1" widget="one2many_list">                        
                                    <list delete="0" create="0" edit="0" context="{'default_base_id': id}">
                                        <field name="budget_id"/>
                                        <field name="concept_id"/>
                                        <field name="uom_id"/>
                                        <field name="cantidad"/>
                                        <field name="price_unit"/>
                                        <field name="price"/>
                                    </list>
                                    <form><p>Información no disponible a través de esta vista</p></form>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_obra_presupuesto_preoperativo" model="ir.actions.act_window">
        <field name="name">Presupuesto Preoperativo</field>
        <field name="res_model">gestion.obra.presupuesto.preoperativo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_obra_presupuesto_preoperativo_tree" model="ir.ui.view">
        <field name="name">gestion.obra.presupuesto.preoperativo.list</field>
        <field name="model">gestion.obra.presupuesto.preoperativo</field>
        <field name="arch" type="xml">
            <list string="Presupuestos Preoperativos">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="date_start"/>
                <field name="date_expiration"/>
                <field name="amount_total_budget" sum="Total"/>
                <!--field name="amount_total_committed" sum="Total"/>
                <field name="amount_total_available" sum="Total"/-->
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_gestion_obra_presupuesto_preoperativo_form" model="ir.ui.view">
        <field name="name">gestion.obra.presupuesto.preoperativo.form</field>
        <field name="model">gestion.obra.presupuesto.preoperativo</field>
        <field name="arch" type="xml">
            <form string="Presupuesto Preoperativo">
                <header>
                    <button name="action_approve" string="Autorizar Preoperativo" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_open_transfer_wizard" string="Trasladar a Presupuesto Kontrol" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,reconciled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                            <field name="project_id" readonly="1" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                            <field name="analytic_id" readonly="1" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                            <field name="gastos"/>
                            <field name="user_id" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_expiration"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Directos" name="lines">
                            <field name="line_ids">
                                <list create="0" editable="bottom">
                                    <field name="budget_domain" column_invisible="1"/>
                                    <field name="budget_id" domain="budget_domain" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                                    <field name="analytic_id" options="{'no_open':True, 'no_create':True, 'no_edit':True}" readonly="1"/>
                                    <field name="product_id" options="{'no_open':True, 'no_create':True, 'no_edit':True}" readonly="1"/>
                                    <field name="name"/>
                                    <field name="amount_budgeted" sum="Total Presupuestado" readonly="1"/>
                                    <!--field name="amount_committed" sum="Total Comprometido"/>
                                    <field name="amount_incurred" sum="Total Incurrido"/>
                                    <field name="amount_available" sum="Total Disponible"/-->
                                    <field name="is_transferred" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total_budget" widget="monetary"/>
                                <field name="amount_total_available" class="oe_subtotal_footer_separator" widget="monetary"/>
                                <!--field name="amount_total_committed" widget="monetary"/>
                                <field name="amount_total_incurred" widget="monetary"/-->
                            </group>
                        </page>
                        <page string="Indirectos" name="indirectos">
                            <field name="indirect_ids">
                                <list editable="bottom">
                                    <field name="budget_domain" column_invisible="1"/>
                                    <field name="budget_id" domain="budget_domain" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                                    <field name="analytic_id" options="{'no_open':True, 'no_create':True, 'no_edit':True}" readonly="1"/>
                                    <field name="product_id" options="{'no_open':True, 'no_create':True, 'no_edit':True}"/>
                                    <field name="name"/>
                                    <field name="amount_budgeted" sum="Total Presupuestado"/>
                                    <!--field name="amount_committed" sum="Total Comprometido"/>
                                    <field name="amount_incurred" sum="Total Incurrido"/>
                                    <field name="amount_available" sum="Total Disponible"/-->
                                    <field name="is_transferred" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <menuitem id="menu_presupuesto_base" name="Presupuesto Base" parent="menu_presupuestos_gestion_obra" action="action_presupuesto_base" sequence="10"/>
    <menuitem id="menu_presupueto_preoperativo" name="Presupuesto Preoperativo" parent="menu_presupuestos_gestion_obra" action="action_obra_presupuesto_preoperativo" sequence="15"/>
</odoo>
