<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- T0120: los botones para confirmar y validar pagos a proveedores solo los ve el Nivel 1 (el candado real está en models/pagos.py) -->
    <record id="view_account_payment_form_ordenacion" model="ir.ui.view">
        <field name="name">account.payment.form.ordenacion.tc</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="puede_ordenar_pago" invisible="1"/>
            </xpath>
            <xpath expr="//header/button[@name='action_post']" position="attributes">
                <attribute name="invisible" add="not puede_ordenar_pago" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='action_validate']" position="attributes">
                <attribute name="invisible" add="not puede_ordenar_pago" separator=" or "/>
            </xpath>
        </field>
    </record>

    <record id="view_batch_payment_form_ordenacion" model="ir.ui.view">
        <field name="name">account.batch.payment.form.ordenacion.tc</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="puede_ordenar_pago" invisible="1"/>
            </xpath>
            <xpath expr="//button[@id='validate_button']" position="attributes">
                <attribute name="invisible" add="not puede_ordenar_pago" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
