<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Tipo de entrada de trabajo: Domingo Trabajado (T0105) -->
        <!-- Dia extra que se paga cuando un empleado de obra trabaja en domingo,
             adicional al descanso dominical (DESC). Redondea a dia completo (FULL/HALF-UP)
             igual que DESC y FESTTRAB. El excedente sobre 5h se paga como OVERTIME. -->
        <record id="work_entry_type_domtrab" model="hr.work.entry.type">
            <field name="name">Domingo Trabajado</field>
            <field name="code">DOMTRAB</field>
            <field name="color">6</field>
            <field name="round_days">FULL</field>
            <field name="round_days_type">HALF-UP</field>
        </record>

    </data>
</odoo>
